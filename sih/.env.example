# =============================================================================
# Unified NER-LIFELINE — environment template
# Copy to `.env.local` for local development. Never commit real secrets.
# =============================================================================

# ---- API layer (server-side, consumed by the Next.js route handlers) ----
# Where the unified FastAPI engine (sih/backend/main.py) listens.
BACKEND_URL=http://127.0.0.1:8000
# Set to "false" to run fully self-contained on the curated offline datasets.
BACKEND_ENABLED=true
# Upstream budget (ms) before a handler degrades to its fallback dataset.
BACKEND_TIMEOUT_MS=3500

# ---- Backend credentials (belong in sih/backend/.env — NEVER expose to the browser) ----
# GOOGLE_ROUTES_API_KEY is used by the FastAPI engine for the Google Routes API v2.
GOOGLE_ROUTES_API_KEY=
GOOGLE_MAPS_API_KEY=
# SerpApi key for highway amenity search (read server-side only).
SERP_API_KEY=
# Supabase PostgreSQL (operational telemetry, VAHAN register).
SUPABASE_URL=
SUPABASE_ANON_KEY=