# =============================================================================
# FastAPI engine environment template (sih/backend/)
# Copy to `sih/backend/.env`. Server-side only — never expose to the browser.
# =============================================================================

# ---- Google Maps Platform (server-side routing engine) ----
GOOGLE_ROUTES_API_KEY=your_google_routes_api_key
GOOGLE_MAPS_API_KEY=your_google_maps_api_key

# ---- SerpApi (highway amenity search; read by the route handler) ----
SERP_API_KEY=your_serpapi_key

# ---- Supabase PostgreSQL (telemetry + VAHAN register) ----
# Leave blank to run the engine on its in-memory datasets.
SUPABASE_URL=
SUPABASE_ANON_KEY=

# ---- Engine runtime ----
API_HOST=127.0.0.1
API_PORT=8000
ENVIRONMENT=development
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173

# ---- Emergency dispatch ----
SOS_RECEIVER_PHONE=+91XXXXXXXXXX
SOS_RECEIVER_RAW=XXXXXXXXXX